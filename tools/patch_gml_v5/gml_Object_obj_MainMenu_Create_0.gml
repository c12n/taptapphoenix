can_spawn_arrows = 1;
miss_sound = 1;
is_ios = os_type == os_ios;
options_file_path = is_ios ? "datafiles/phoenixoptions.ini" : "phoenixoptions.ini";
ini_open(options_file_path);
can_spawn_arrows = ini_read_real("options", "spawn_arrows", 1);
miss_sound = ini_read_real("options", "miss_sound", 1);
no_fail = ini_read_real("options", "no_fail", 0);
global.account_key = ini_read_string("account", "account_key", "");
global.account_username = ini_read_string("account", "account_username", "");
var _is_first_run = ini_read_real("options", "first_run", 1);
if (_is_first_run)
{
    show_message_async("You must create an account to submit scores, please visit the options");
    ini_write_real("options", "first_run", 0);
}
ini_close();
chosen_option = "";
button_opacity = 0.95;
song_menu = [["Test", -4]];
difficulty_menu = [["Easy Tracks", song_menu], ["Medium Tracks", song_menu], ["Hard Tracks", song_menu], ["Extreme Tracks", song_menu]];
create_account_menu = [["", -4]];
login_menu = [["", -4]];
options_menu = [["Arrows:", -4], ["Miss Sound:", -4], ["No Fail:", -4], ["Create Account", create_account_menu], ["Login", login_menu]];
home_menu = [["Play", difficulty_menu], ["Options", options_menu], ["Credits", -4]];
current_menu = home_menu;
menu_nav = [home_menu];
menu_index = 0;
menu_item_width = sprite_get_width(spr_MenuItem);
menu_item_height = sprite_get_height(spr_MenuItem);
menu_item_starting_x = 0;
menu_item_starting_y = 300 + global.notch_padding;
menu_item_current_y = 0;
menu_item_count = array_length(current_menu);
menu_drag_y_offset = 0;
menu_is_dragging = 0;
menu_item_surface_start_y = 0;
menu_item_surface_current_y = 0;
menu_item_surface_height = menu_item_height * menu_item_count;
menu_item_surface_min_y = menu_item_surface_start_y - ((menu_item_height * menu_item_count) - menu_item_surface_height);
menu_item_surface_max_y = menu_item_surface_start_y;
main_surface = surface_create(menu_item_width, room_height - menu_item_starting_y);
menu_item_surface = surface_create(menu_item_width, menu_item_surface_height);
difficulty = "";
variable_struct_set(global.songs, "jaroslavBeckLegend", [[1, 0, 0, 0, "Jaroslav Beck", "Legend ft Backchat"], 2, "Jaroslav Beck - Legend Ft Backchat (_).tap", 2]);
variable_struct_set(global.songs, "lilGodd67", [[1, 0, 0, 0, "Lil Godd", "The 6 7 Song"], 25, "Lil Godd - The 6 7 Song (_).tap", 5]);
allSongs = variable_struct_get_names(global.songs);
song_list = -4;
draw_set_halign(fa_left);
event_user(0);
