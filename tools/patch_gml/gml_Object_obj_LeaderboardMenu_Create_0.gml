current_menu = home_menu;
menu_nav = [home_menu];
menu_index = 0;
menu_item_width = sprite_get_width(spr_MenuItem);
menu_item_height = sprite_get_height(spr_MenuItem);
menu_item_starting_x = 0;
menu_item_starting_y = 490;
menu_item_current_y = 0;
