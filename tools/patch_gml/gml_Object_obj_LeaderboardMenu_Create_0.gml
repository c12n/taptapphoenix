post = http_post_string("https://ttp.07051969.xyz/pull_leaderboard.php?auth=" + global.tap_phoenix_key, "&artist=" + global.curr_song_artist + "&song=" + global.curr_song_title + "&difficulty=" + global.curr_song_difficulty);
button_opacity = 0.95;
